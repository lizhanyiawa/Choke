# Choke! 本地环境配置
# 复制为根目录 .env 后填写。.env 已被 gitignore。
# 这些变量只由 apps/api 读取；不要加 VITE_ 前缀，否则会被打进前端包。

# --- osu! OAuth（必填）---
# 应用管理：https://osu.ppy.sh/home/account/edit#new-oauth-application
# 同一个应用既用于登录，也用于可选的卡池数据同步，所以 Callback URL 不能留空：
#   http://localhost:3100/auth/osu/callback
# 必须精确一致：不能带结尾斜杠，不能改成 127.0.0.1，端口必须是 3100。
# 改 API 端口时，要同步改 API_BASE_URL，并到 osu! 应用页改回调地址。
OSU_CLIENT_ID=74418
OSU_CLIENT_SECRET=replace-with-your-osu-client-secret

# --- session 签名（建议显式设置）---
# 任意长随机字符串，例如 `openssl rand -hex 32` 的输出。
# 不填会依次回退到 OSU_CLIENT_SECRET、再不安全的 "choke-dev"；改掉后旧登录全部失效。
SESSION_SECRET=replace-with-a-long-random-string

# --- 地址（默认值如下；端口变了必须改）---
# 末尾不要带斜杠，否则会拼出 //auth 或 //gacha。
API_BASE_URL=http://localhost:3100
# 前端实际地址。本地常用 5207 时改成 http://localhost:5207。
WEB_BASE_URL=http://localhost:5173

# --- 本地数据库（可选）---
# 相对 apps/api 的工作目录解析；首次启动自动建表。
# PGlite 单进程单连接：不要在 API 运行时用另一个进程打开同一个目录。
PG_DATA_DIR=./.data/pg

# --- API 监听端口（可选）---
# 改这里必须同时改 API_BASE_URL，以及 vite.config.ts 里 /api、/auth 的代理目标。
PORT=3100
