{
  "name": "choke",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @choke/api run dev",
    "import:sample": "pnpm --filter @choke/api exec tsx scripts/import-cards.ts samples/sample-cards.json",
    "import:cards": "pnpm --filter @choke/api exec tsx scripts/import-cards.ts data/choke-cards.json --replace",
    "build:cards": "pnpm --filter @choke/api exec tsx ../../scripts/build-cards.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b && pnpm --filter @choke/api typecheck",
    "content:check": "pnpm --filter @choke/api exec tsx scripts/check-content.ts",
    "docs:skills": "pnpm --filter @choke/api exec tsx scripts/gen-skill-table.ts",
    "docs:check": "pnpm --filter @choke/api exec tsx scripts/gen-skill-table.ts --check",
    "test": "pnpm --filter @choke/api exec tsx scripts/run-tests.ts",
    "test:fast": "pnpm --filter @choke/api exec tsx scripts/run-tests.ts --fast",
    "test:db": "pnpm --filter @choke/api exec tsx scripts/run-tests.ts --db",
    "test:content": "pnpm --filter @choke/api exec tsx scripts/test-content-errors.ts",
    "test:weakness": "pnpm --filter @choke/api exec tsx scripts/test-weakness.ts",
    "test:skills": "pnpm --filter @choke/api exec tsx scripts/test-skills.ts",
    "test:expedition": "pnpm --filter @choke/api exec tsx scripts/test-expedition.ts",
    "test:lineup": "pnpm --filter @choke/api exec tsx scripts/test-lineup.ts",
    "test:unlocks": "pnpm --filter @choke/api exec tsx scripts/test-unlocks.ts",
    "test:feature-locks": "pnpm --filter @choke/api exec tsx scripts/test-feature-locks.ts",
    "test:account-binding": "pnpm --filter @choke/api exec tsx scripts/test-account-binding.ts",
    "test:mail": "pnpm --filter @choke/api exec tsx scripts/test-mail.ts",
    "test:p2": "pnpm --filter @choke/api exec tsx scripts/test-p2.ts",
    "test:quests": "pnpm --filter @choke/api exec tsx scripts/test-quests.ts",
    "test:osu-daily": "pnpm --filter @choke/api exec tsx scripts/test-osu-daily.ts",
    "test:ledger": "pnpm --filter @choke/api exec tsx scripts/test-ledger.ts",
    "test:expedition-run": "pnpm --filter @choke/api exec tsx scripts/test-expedition-run.ts",
    "test:difficulty": "pnpm --filter @choke/api exec tsx scripts/test-difficulty.ts",
    "test:admin": "pnpm --filter @choke/api exec tsx scripts/test-admin.ts",
    "test:pg": "pnpm --filter @choke/api exec tsx scripts/run-tests.ts --pg",
    "admin:set": "pnpm --filter @choke/api exec tsx scripts/set-admin.ts",
    "test:battle": "pnpm --filter @choke/api exec tsx scripts/test-battle.ts",
    "preview": "vite preview",
    "sync:osu": "node scripts/sync-osu.mjs",
    "sync:rankings": "node scripts/sync-rankings.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "cn": "^0.5.0",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
